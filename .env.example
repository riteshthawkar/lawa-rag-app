# Lawa AI RAG Agent Environment Variables
# Copy this file to .env and fill in your values

# API Keys
PINECONE_API_KEY=your-pinecone-api-key
OPENAI_API_KEY=your-openai-api-key
HF_TOKEN=your-huggingface-token
SECRET_KEY=your-jwt-secret-key

# Model Configuration
MAIN_MODEL=gpt-5.4
QUERY_REWRITING_MODEL=gpt-5.4-mini
FALLBACK_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0

# Retrieval Configuration
PINECONE_INDEX_NAME=combined-vectorstore
TOP_K_DOCS=40
RERANK_TOP_N=20
ALPHA_HYBRID=0.6
RERANK_MODEL=cohere-rerank-3.5

# Server Configuration
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_URL=http://localhost:8000
SERVICE_NAME=lawa-rag
SERVICE_ENVIRONMENT=development

# Response Configuration
MAX_COMPLETION_TOKENS=1024
MAIN_MODEL_TEMPERATURE=0
FALLBACK_MODEL_TEMPERATURE=0.2
QUERY_REWRITING_TEMPERATURE=0.1
GENERATION_PROBE_QUESTION=What is the UAE Golden Visa?

# Clarification Configuration
ENABLE_CLARIFICATION=true
MAX_CLARIFICATION_ATTEMPTS=2
CLARIFICATION_TIMEOUT=30

# WebSocket Configuration
WEBSOCKET_TIMEOUT=30
CHUNK_BUFFER_SIZE=1

# Logging
LOG_LEVEL=INFO

# Deployment Metadata
RELEASE_VERSION=unknown
COMMIT_SHA=unknown
DEPLOYED_AT=unknown
DEPLOYED_BY=unknown
RELEASE_NOTES_SUMMARY=

# Operations Metadata
SERVICE_OWNER=
RUNBOOK_URL=
DASHBOARD_SERVICE_ID=
PRIMARY_REPOSITORY_URL=
PUBLIC_BASE_URL=
